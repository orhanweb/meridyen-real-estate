# Public site URL (used for SEO, canonical URLs, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (optional — controls real vs mock email dispatch) ────────────────
# When RESEND_API_KEY is empty, the contact action runs in MOCK MODE:
#   • the form succeeds end-to-end,
#   • all anti-spam checks (honeypot, time-trap, rate-limit) still run,
#   • but no email leaves the server (the payload is logged for inspection).
# Set the key from https://resend.com to switch to real delivery.
RESEND_API_KEY=

# Inbox that receives contact-form submissions.
# Falls back to siteConfig.contact.email when unset.
CONTACT_TO_EMAIL=

# Verified sender. Format: "Display Name <address@your-domain.com>".
# When unset, the action uses Resend's onboarding@resend.dev sandbox sender,
# which only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=

# ─── Upstash (optional — rate limiting backend) ──────────────────────────────
# Required in production. In dev, an in-memory bucket is used as a fallback.
# Provision a Redis database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
